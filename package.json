{
  "name": "@apodemakeles/dsh-gui",
  "description": "Desktop shell for dsh (DeepSeek Harness): an Electron app delivered as a dsh bundle — booted via `dsh --profile gui`, reusing the official web client over an IPC fetch carrier.",
  "version": "0.3.0",
  "type": "module",
  "main": "lib/index.mjs",
  "bin": {
    "dsh-gui-token-usage": "lib/cli.js"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./webserver": {
      "types": "./lib/webserver.d.mts",
      "default": "./lib/webserver.mjs"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build:plugin": "tsdown",
    "build:shell": "electron-vite build",
    "build": "electron-vite build && tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:mac": "pnpm run build && node scripts/package-mac.mjs",
    "prepare": "pnpm run build"
  },
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "desktop",
    "electron",
    "gui",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apodemakeles/dsh-gui.git"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib",
    "out",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "electron": "^37.3.1",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.1",
    "@deepseek-ai/dsh-web-frontend": "0.1.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "~5.7.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.1"
  },
  "build": {
    "appId": "com.apodemakeles.dsh-gui",
    "productName": "dsh-gui",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  }
}
